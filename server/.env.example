# Set these in the Vercel dashboard: Settings -> Environment Variables.
# Never commit the filled-in values, and never paste them into a chat.

# The whole service-account JSON from the Firebase console, on one line:
#   Project settings -> Service accounts -> Generate new private key
# This grants full admin access to the project. It exists only here, on the
# server, and never reaches the app or the admin panel's browser bundle.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"nepaliko-radio",...}

FIREBASE_PROJECT_ID=nepaliko-radio
